# STT Arena - API Keys Configuration
# Copy this file to .env and fill in your actual API keys

# Google Gemini API Key (for Golden Transcript generation)
GEMINI_API_KEY=your_gemini_api_key_here

# Gladia API Key (STT Provider)
GLADIA_API_KEY=your_gladia_api_key_here

# OpenAI API Key (Whisper STT)
OPENAI_API_KEY=your_openai_api_key_here

# Behavioral Signals API Key (STT with emotion analysis)
BEHAVIORAL_SIGNALS_API_KEY=your_behavioral_signals_api_key_here
BEHAVIORAL_SIGNALS_URL=your_behavioral_signals_endpoint_here

# Deepgram API Key (Optional - Alternative STT provider)
DEEPGRAM_API_KEY=your_deepgram_api_key_here
